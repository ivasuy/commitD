# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cursor
.superpowers

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mobile app dependencies and generated outputs
/mobile/node_modules/
/mobile/.tmp/
/mobile/dist/
/mobile/build/

# capacitor native build outputs
/mobile/android/.gradle/
/mobile/android/build/
/mobile/android/app/build/
/mobile/android/app/release/
/mobile/android/capacitor-cordova-android-plugins/build/
/mobile/android/**/.cxx/
/mobile/android/**/outputs/
/mobile/android/local.properties
/mobile/android/*.jks
/mobile/android/*.keystore

/mobile/ios/build/
/mobile/ios/DerivedData/
/mobile/ios/App/Pods/
/mobile/ios/App/CapApp-SPM/build/
/mobile/ios/App/Podfile.lock
/mobile/ios/App/*.xcworkspace/xcuserdata/
/mobile/ios/App/*.xcodeproj/xcuserdata/
/mobile/ios/App/*.xcodeproj/project.xcworkspace/xcuserdata/
/mobile/ios/App/**/xcuserdata/
/mobile/ios/App/**/*.xcuserstate
